# Copy this file to .env (gitignored, never commit real values) and fill in as needed.
# Same secrets discipline as the Flutter app's Secrets.xcconfig / agora_config.dart —
# see CLAUDE.md's standing rule on this.

# Port the Express HTTP server listens on.
PORT=3000

# development | production. Controls things like whether stack traces/dev-only
# fields (e.g. Task 2's debugOtp) are ever included in a response — never in production.
NODE_ENV=development

# Local dev Redis, provisioned by docker-compose.yml. Consumed from Task 2
# onward (OTP storage, refresh-token tracking, user records).
REDIS_URL=redis://redis:6379

# Signs both access and refresh JWTs (distinguished by a `type` claim in the
# payload — see src/services/token.ts). MUST be set to a real random value in
# production — src/config/env.ts throws at startup if NODE_ENV=production and
# this is still the dev default below. Generate one with e.g.
# `openssl rand -hex 32`. Never commit a real value here.
JWT_SECRET=dev-insecure-secret-change-me

# Agora PTT audio token generation (POST /parties/:id/agora-token), added
# 2026-09-16 — see src/services/agoraToken.ts and
# docs/technical/systems/ptt-audio.md for why this exists.
#
# AGORA_APP_ID is NOT a secret (it already ships inside the Flutter client
# binary) — src/config/env.ts ships a real default matching
# app/lib/config/agora_config.dart, so leaving this unset is fine.
AGORA_APP_ID=d691c4fe2e824e469799dae35e72eee2

# AGORA_APP_CERTIFICATE IS a real secret — from Agora Console > your project
# > Features > App Certificate. Never commit a real value here. Leaving this
# unset is fine for every part of the backend except POST
# /parties/:id/agora-token, which returns a typed 503 until it's set (see
# src/config/env.ts's startup warning and agoraToken.ts).
AGORA_APP_CERTIFICATE=

# How long a minted PTT channel-join token stays valid, in seconds. Default
# (used when unset) is 14400 (4 hours) — see src/config/env.ts's comment for
# why.
AGORA_TOKEN_EXPIRY_SECONDS=
